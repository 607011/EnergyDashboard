INVERTER_HOST=192.168.0.174
INVERTER_PORT=502
MODBUS_UNIT=1
MODBUS_TIMEOUT=5
POLL_INTERVAL=10
# After this long without a successful poll, dashboards show "no data" instead of a frozen,
# increasingly wrong last value.
STALE_AFTER_SECONDS=120
# How long history data is kept per metric in RedisTimeSeries
TS_RETENTION_DAYS=365

# Location for the sun position calculation (azimuth/elevation on the dashboard).
# Leave empty to disable the calculation. (Example values: Berlin.)
LAT=52.5200
LON=13.4050

# Local timezone (IANA name), used to determine "today" for the daily kWh
# totals on the dashboard. Defaults to UTC if unset.
TIMEZONE=Europe/Berlin

LOG_LEVEL=INFO

# Grafana admin login (set on first start)
GRAFANA_ADMIN_PASSWORD=admin

# Additional Grafana users, created/updated on every "docker compose up"
# (password is synced for existing users). Format:
# login:password:role:email,login2:password2:role2:email2
# -- role: Viewer/Editor/Admin (default Viewer); email is optional, but needed for
# "Sign in with Google" to find the matching Grafana user.
GRAFANA_USERS=family:aSecurePassword:Viewer:family@example.com

# Public URL Grafana is reached at. The Google redirect URI is <this>login/google.
# Google only accepts https:// on a public-TLD hostname, or http://localhost.
GRAFANA_ROOT_URL=http://localhost:3000/

# HTTPS reverse proxy (Caddy) -- see README "HTTPS reverse proxy". Off unless the
# "proxy" compose profile is enabled; it takes over ports 80/443, so on the Pi the
# Pi-hole web UI has to be moved to 8080/8443 first.
# COMPOSE_PROFILES=proxy
GRAFANA_DOMAIN=smart.example.com
# Credentials from: curl -X POST https://auth.acme-dns.io/register
ACMEDNS_USERNAME=
ACMEDNS_PASSWORD=
ACMEDNS_SUBDOMAIN=
ACMEDNS_SERVER_URL=https://auth.acme-dns.io

# "Sign in with Google" (optional). Create an OAuth client (type "Web application")
# in the Google Cloud Console and register <GRAFANA_ROOT_URL>login/google as its
# authorized redirect URI. See README.
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# false = only Grafana users that already exist (matched by email) may log in with Google.
GOOGLE_ALLOW_SIGN_UP=false
# Optional: additionally restrict to Google Workspace domains, comma/space separated.
# Do NOT put gmail.com here -- that would admit every Gmail user.
GOOGLE_ALLOWED_DOMAINS=

# Hoymiles S-Miles cloud account (WB-series microinverters have no local API,
# see hoymiles-poller/hoymiles_client.py for why). Same credentials as the
# S-Miles / S-Miles Home app.
HOYMILES_USER=you@example.com
HOYMILES_PASSWORD=yourPassword

# Optional "id:name,id:name" override; leave empty to auto-discover and poll
# every station on the account. Station IDs are visible in the S-Miles web
# portal URL when viewing a station.
HOYMILES_STATIONS=

# The cloud isn't built for tight polling; a few minutes is plenty for a dashboard.
HOYMILES_POLL_INTERVAL=300
# Cloud data is already a few minutes old by nature, hence the longer default.
HOYMILES_STALE_AFTER_SECONDS=900

# Weishaupt heat pump (Geoblock WGB, also WBB/WAB/WSB) via Modbus TCP. Enable it in the
# heat pump's system device: Settings -> Modbus TCP -> access on (port 502, slave 1).
# Note: Weishaupt allows either the WEM portal or Modbus TCP, not both at once.
# Leave WEISHAUPT_HOST empty if you have no heat pump.
WEISHAUPT_HOST=
WEISHAUPT_POLL_INTERVAL=30
WEISHAUPT_STALE_AFTER_SECONDS=120
# Number of heating circuits installed (1..4); absent circuits would log zeros.
WEISHAUPT_HEATING_CIRCUITS=2

# Shelly Gen3+ smart plugs, read locally (no cloud): "name:host,name:host". Give a plug the same
# name as its load in COMPUTE_MACHINES below and compute-controller automatically switches from an
# estimated wattage to the plug's real reading -- no other change needed. Leave empty if you have
# none yet.
SHELLY_DEVICES=
# Optional: SHELLY_POLL_INTERVAL=10, SHELLY_STALE_AFTER_SECONDS=60

# Load management on PV surplus: "name:watts[:kind],..." in priority order, watts = consumption
# under full load. Two kinds: "pc" (default, dry run only for now) and "tuya" (a local Tuya device,
# e.g. a dehumidifier, really switched -- see README for local_key setup). Leave empty to disable
# (the controller still runs, just to publish the PV surplus for anything that wants to read it).
COMPUTE_MACHINES=
# "dryrun" (default) never actuates anything; "live" actuates every machine that has its
# actuator configured (see below) -- one without it stays dry-run regardless.
COMPUTE_MODE=dryrun
# For each "tuya" machine (<NAME> = its name in COMPUTE_MACHINES, upper-cased):
# TUYA_<NAME>_ID=
# TUYA_<NAME>_KEY=
# TUYA_<NAME>_IP=                    optional, skips LAN broadcast discovery
# TUYA_<NAME>_VERSION=3.3            protocol version; some devices need 3.4 or 3.5
# TUYA_<NAME>_DPS_SWITCH=1           which DPS number is the power switch (default "1")
# For each "pc" machine you want really actuated (see README "Setting up a pc machine's actuator"
# for the SSH keypair setup both methods need):
# PC_<NAME>_ACTUATOR=shelly          "shelly" (SSH shutdown + cut its plug) or "wol" (SSH sleep +
#                                    Wake-on-LAN; for a machine that won't reboot on power restore)
# PC_<NAME>_SSH_HOST=
# PC_<NAME>_SSH_USER=
# PC_<NAME>_MAC=                     only for "wol"
# PC_SSH_KEY_PATH=/run/secrets/pc-ssh/id_ed25519   default matches docker-compose.yml's mount
# Optional tuning (defaults shown):
# COMPUTE_BATTERY_FULL_BY_HOUR=12   machines may take surplus from the battery as long as the
#                                   forecast still fills it by then (else: by the evening)
# COMPUTE_BATTERY_MAX_CHARGE_W=2500 surplus above this goes to the grid anyway -> free for machines
# COMPUTE_BATTERY_CAPACITY_WH=      default: read from the battery (maximum_energy)
# COMPUTE_FORECAST_DERATE=0.8       safety factor on the irradiance forecast
# COMPUTE_SOC_ON=80             battery level (%) needed to start a machine, only without a forecast
# COMPUTE_SOC_MIN=40            below this machines are stopped at once, while the battery discharges
# COMPUTE_MARGIN_ON_W=200       surplus needed on top of the load to start a machine
# COMPUTE_TOLERANCE_OFF_W=100   how far below the load the surplus may sink before stopping
# COMPUTE_SMOOTH_MIN=15         averaging window (minutes) for production and surplus
# COMPUTE_ON_DELAY_MIN=15       a start condition must hold this long before the machine starts
# COMPUTE_OFF_DELAY_MIN=20      a stop condition must hold this long before the machine stops
# COMPUTE_MIN_ON_MIN=45         minimum run time
# COMPUTE_MIN_OFF_MIN=45        minimum pause
