INVERTER_HOST=192.168.0.174
INVERTER_PORT=502
MODBUS_UNIT=1
MODBUS_TIMEOUT=5
POLL_INTERVAL=10
# Wie lange History-Daten je Messwert in RedisTimeSeries aufbewahrt werden
TS_RETENTION_DAYS=365

# Standort für die Sonnenstandsberechnung (Azimut/Elevation im Dashboard).
# Leer lassen, um die Berechnung zu deaktivieren.
LAT=52.456673
LON=10.0256317
LOG_LEVEL=INFO

# Grafana Admin-Login (beim ersten Start gesetzt)
GRAFANA_ADMIN_PASSWORD=admin

# Weitere Grafana-Nutzer, werden bei jedem "docker compose up" angelegt/aktualisiert
# (Passwort wird bei bestehenden Nutzern synchronisiert). Format:
# login:passwort:rolle,login2:passwort2:rolle2  -- Rolle: Viewer/Editor/Admin (Default Viewer)
GRAFANA_USERS=familie:einSicheresPasswort:Viewer
