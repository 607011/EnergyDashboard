# Reverse proxy in front of Grafana and the Pi-hole web UI.
# Env vars come from docker-compose.yml / .env.

# HTTPS name (used for "Sign in with Google", which requires https:// on a
# public-TLD hostname). The certificate comes from Let's Encrypt via the DNS-01
# challenge, delegated through ACME-DNS so no DNS-provider credentials are needed.
{$GRAFANA_DOMAIN} {
	tls {
		dns acmedns {
			username {$ACMEDNS_USERNAME}
			password {$ACMEDNS_PASSWORD}
			subdomain {$ACMEDNS_SUBDOMAIN}
			server_url {$ACMEDNS_SERVER_URL}
		}
		# Check DNS propagation against public resolvers. The LAN resolver (Pi-hole)
		# has a local record for this hostname, which confuses the zone lookup.
		resolvers 1.1.1.1 8.8.8.8
	}
	# Meter reading form: only for users logged in to Grafana (a session cookie is valid on this
	# origin). Grafana's /api/user answers 200 for them; everyone else is sent to the login page.
	redir /meter /meter/
	handle /meter/* {
		forward_auth grafana:3000 {
			uri /api/user
			@unauth status 401
			handle_response @unauth {
				redir * /login?redirect_to=%2Fmeter%2F 302
			}
		}
		uri strip_prefix /meter
		reverse_proxy meter-form:8000
	}

	# Push notifications: the page and its API only for logged-in Grafana users, like the meter
	# form. The service worker script is fetched by the browser on its own (also for updates, when
	# a session may have expired) and holds nothing private, so it is served without login.
	handle /push/sw.js {
		uri strip_prefix /push
		reverse_proxy push:8000
	}
	redir /push /push/
	handle /push/* {
		forward_auth grafana:3000 {
			uri /api/user
			@unauth status 401
			handle_response @unauth {
				redir * /login?redirect_to=%2Fpush%2F 302
			}
		}
		uri strip_prefix /push
		reverse_proxy push:8000
	}

	# Home-screen app (iPhone/iPad, "Add to Home Screen"): icon and manifest, served without login.
	handle /pwa/* {
		root * /srv
		file_server
	}

	# Grafana already asks for standalone mode; we only swap its icon for ours and add a manifest
	# (start page, name) and a short app title, by rewriting the HTML it serves. The rewrite needs
	# an uncompressed upstream response.
	handle {
		replace {
			match {
				header Content-Type text/html*
			}
			public/img/apple-touch-icon.png /pwa/apple-touch-icon.png
			</head> `<link rel="manifest" href="/pwa/manifest.webmanifest"><meta name="apple-mobile-web-app-title" content="Energie"></head>`
		}
		reverse_proxy grafana:3000 {
			header_up Accept-Encoding identity
		}
	}
}

# Short plain-HTTP names on the LAN.
http://solar, http://solar.lan, http://dashboard.lan {
	reverse_proxy grafana:3000
}

# Everything else arriving on port 80 (pihole, pihole.lan, the raw IP, ...) is
# the Pi-hole web UI, which has been moved to port 8080 on the host.
http:// {
	reverse_proxy host.docker.internal:8080
}
